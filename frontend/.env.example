# Copy to .env.local for local dev. Set the same keys in Vercel (Preview first).
# Never commit real values.

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Project Settings -> API) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Used by the Stripe webhook, metering, and the KB refresh cron.
SUPABASE_SERVICE_ROLE_KEY=

# --- Vercel AI Gateway ---
# On Vercel, OIDC auth is automatic once AI Gateway is enabled on the team.
# Locally, create a key in Vercel -> AI Gateway -> API keys.
AI_GATEWAY_API_KEY=
SKILLCO_DRAFT_MODEL=openai/gpt-5-mini
SKILLCO_FINAL_MODEL=anthropic/claude-sonnet-5.5
SKILLCO_EMBED_MODEL=openai/text-embedding-3-small

# --- Stripe (Developers -> API keys / Webhooks) ---
STRIPE_SECRET_KEY=sk_test_
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_
STRIPE_WEBHOOK_SECRET=whsec_
# Recurring prices
STRIPE_PRICE_BUILDER_MONTHLY=price_
STRIPE_PRICE_PRO_MONTHLY=price_
# Metered price attached to a Billing Meter (event name below), $0.49 per credit
STRIPE_PRICE_CREDIT_OVERAGE=price_
STRIPE_METER_EVENT_NAME=skillco_credits
# Optional storage add-on (+10 GB)
STRIPE_PRICE_STORAGE_10GB=price_

# --- Cron ---
# Vercel sends "Authorization: Bearer $CRON_SECRET" to cron routes.
CRON_SECRET=
